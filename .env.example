# Copie para .env.local e preencha. Nunca versione valores reais.
# Na Vercel, cadastre os mesmos nomes em Settings → Environment Variables (Production e Preview).

# Banco (Neon) — a integração Neon na Vercel preenche estas duas sozinha
DATABASE_URL=            # conexão com pooling (o app usa esta)
DATABASE_URL_UNPOOLED=   # conexão direta (migrations e pg_dump)

# Login (Auth.js)
AUTH_SECRET=             # gerar com: npx auth secret
ADMIN_SENHA_INICIAL=     # senha do primeiro admin, usada só pelo npm run db:seed; NÃO vai para a Vercel

# PDF (Railway)
PDF_SERVICE_URL=
PDF_SERVICE_TOKEN=       # segredo compartilhado entre o app e o serviço de PDF

# AWS S3
AWS_REGION=sa-east-1
S3_BUCKET=aquapulse-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# E-mail (Resend)
RESEND_API_KEY=
RELATORIO_EMAIL_PARA=    # e-mail do RH que recebe o relatório mensal

# Métricas
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=       # só no build (upload de source maps)

# Botões ESP32
ESP32_PULSO_SEGREDO=     # assina o token de cada botão cadastrado no Admin

# Jira (REST API) — só para as ferramentas de desenvolvimento; NÃO vai para a Vercel
JIRA_BASE_URL=           # ex.: https://aquapulse.atlassian.net
JIRA_EMAIL=              # e-mail da conta que gerou o token (de preferência a conta do projeto)
JIRA_API_TOKEN=          # id.atlassian.com → Segurança → Criar e gerenciar tokens de API
